# warpllm environment template.
#
# Copy this file to `.env` and fill in your keys:
#
#     cp .env.example .env
#
# Then make them available to the process. warpllm reads the environment
# directly (std::env) and loads no dotenv file itself, so a `.env` on disk is
# inert until something sources it — either your shell, `set -a; source .env;
# set +a`, a wrapper like `dotenv`, or the environment block of your container.
#
# Credentials
# -----------
# Keys are read at REQUEST time, from the environment variable named by the
# routed provider's registry entry (crates/warpllm/src/registry/specs.yaml).
# The client never asks for a key up front; a request only needs the key of
# the provider it lands on. Set the ones you use, leave the rest empty.
#
# There is no per-caller key today and no shared variable between providers:
# the registry tests reject a shared env_api_key, because it silently
# authenticates one provider with the other's credentials. Each key below is
# that provider's alone.

# The openai provider. Base URL: https://api.openai.com/v1.
# Required for any request routed to a model under `openai/`.
OPENAI_API_KEY=

# The deepseek provider. Base URL: https://api.deepseek.com.
# Required for any request routed to a model under `deepseek/`.
DEEPSEEK_API_KEY=

# Observability
# -------------
# Server log level, honored by warpllm-server's init_tracing() (which installs
# the fmt subscriber with EnvFilter). Defaults to `info` when unset. Use
# tracing filter syntax, e.g. `warpllm=debug,tower_http=info` to tune per crate.
RUST_LOG=info

# Runtime endpoints (not environment variables)
# --------------------------------------------
# The gateway's host, port, and upstream timeout are CLI flags, not env vars:
# `--host` (default 0.0.0.0), `--port` (default 8080), and `--timeout-secs`
# (default 600). They are listed here only so contributors know where to look —
# set them on the command line, not in this file.

# Development only
# ----------------
# napi-generated hooks in bindings/node/index.js and warpllm.wasi.cjs. They
# exist to exercise the Node binding during development and are never needed
# by end users of the published packages. Leave unset unless you are
# debugging the native module loading itself.

# Load the native module from a custom path instead of the installed one.
#NAPI_RS_NATIVE_LIBRARY_PATH=

# Treat a native/JS version mismatch as a hard error instead of a warning.
#NAPI_RS_ENFORCE_VERSION_CHECK=

# Force the WASI binding (values: 'true' | 'error').
#NAPI_RS_FORCE_WASI=

# WASI thread-pool sizing; UV_THREADPOOL_SIZE is honored as a fallback.
#NAPI_RS_ASYNC_WORK_POOL_SIZE=
